generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/****  Common Enums  ****/

enum Status {
  ACTIVE
  INACTIVE
}

enum GENDER {
  MALE
  FEMALE
  OTHER
}

/****  User Enums  ****/

enum UserStatus {
  ACTIVE
  INACTIVE
  PAYMENT_PENDING
  PENDING
}

/****  Mandal Enums  ****/

enum MANDAL_STRATEGY {
  GROWING
  COLLECTIVE
}

enum MemberRole {
  MANDAL_ADMIN
  MEMBER
}

/****  Loan Enums  ****/

enum LoanStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  PARTIALLY_REPAID
  REPAID
  CANCELLED
}

/****  Plans and Transaction Enums  ****/

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  MEMBERSHIP_FEE
  PENALTY
  EXPENSE
  INCOME
}

enum PaymentMethodType {
  CASH
  BANK
  UPI
  CARD
  CHEQUE
}

enum EntryType {
  DEBIT
  CREDIT
}

/****  Subscription Enums  ****/

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

/****  Contribution Enums  ****/

enum ContributionType {
  DEPOSIT
  MONTHLY_FEE
  PENALTY
  LOAN
  LOAN_REPAYMENT
  WITHDRAWAL
  ADJUSTMENT
  OTHER
}

/****  Notification Enums  ****/

enum NotificationType {
  INFO
  PAYMENT
  REMINDER
  ALERT
}

// ==============================
// PLAN
// ==============================

model Plan {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  membersCapacity Int      @map("members_capacity")
  planAmount      Decimal  @db.Decimal(12, 2) @map("plan_amount")
  description     String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  mandals       MandalMaster[]
  subscriptions Subscription[]

  @@map("plans")
}

// ==============================
// MANDAL MASTER
// ==============================

model MandalMaster {
  id              Int             @id @default(autoincrement())
  code            String          @unique
  mandalName      String          @map("mandal_name")
  status          Status          @default(ACTIVE)
  address         String
  city            String
  state           String
  pincode         String
  mandalStrategy  MANDAL_STRATEGY @map("mandal_strategy")
  mandalPlanId    Int             @map("mandal_plan_id")
  mandalPlan      Plan            @relation(fields: [mandalPlanId], references: [id])
  amount          Decimal         @db.Decimal(12, 2)
  memberLimit     Int?            @map("member_limit")
  isTrialActive   Boolean         @default(true) @map("is_trial_active")
  mandalStartDate       DateTime        @default(now()) @map("mandal_start_date")
  mandalInterestPercent Int?            @default(0) @map("mandal_interest_percent")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  members             MandalMember[]
  paymentTransactions PaymentTransaction[]
  subscriptions       Subscription[]
  contributions       Contribution[]
  notifications       Notification[]
  drawWinners         DrawWinner[]
  loans               Loan[]
  loanRepayments      LoanRepayment[]

  @@map("mandal_master")
}

// ==============================
// ADMIN USER
// ==============================

model AdminUser {
  id          Int       @id @default(autoincrement())
  fullName    String    @map("full_name")
  email       String    @unique
  password    String
  status      Status    @default(ACTIVE)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("admin_users")
}

// ==============================
// USER
// ==============================

model User {
  id               Int        @id @default(autoincrement())
  fullName         String     @map("full_name")
  email            String
  countryCode      String     @default("+91") @map("country_code")
  mobileNumber     String     @map("mobile_number") @unique
  status           UserStatus @default(ACTIVE)
  gender           GENDER
  birthDate        DateTime?  @map("birth_date")
  address          String
  city             String?    @map("city")
  state            String?    @map("state")
  pincode          String?    @map("pincode")
  profilePicture   String?    @map("profile_picture")
  isMobileVerified Boolean    @default(false) @map("is_mobile_verified")
  lastLoggedInAt   DateTime?  @map("last_loggedin_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  memberships         MandalMember[]
  memberAccounts      MemberAccount[]
  paymentTransactions PaymentTransaction[]
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  loanApprovals       LoanApproval[]
  createdRepayments   LoanRepayment[]

  @@unique([countryCode, mobileNumber])
  @@map("users")
}

// ==============================
// REFRESH TOKEN
// ==============================

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ==============================
// OTP MASTER
// ==============================

model OtpMaster {
  id           Int      @id @default(autoincrement())
  countryCode  String   @default("+91") @map("country_code")
  mobileNumber String   @map("mobile_number")
  otp          String
  expireAt     DateTime @map("expire_at")
  isUsed       Boolean  @default(false) @map("is_used")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([countryCode, mobileNumber, isUsed])
  @@map("otp_master")
}

// ==============================
// MANDAL MEMBER
// ==============================

model MandalMember {
  id        Int        @id @default(autoincrement())
  mandalId  Int        @map("mandal_id")
  userId    Int        @map("user_id")
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime?  @map("joined_at")
  leftAt    DateTime?  @map("left_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  mandal        MandalMaster   @relation(fields: [mandalId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  contributions Contribution[]
  drawWinners   DrawWinner[]
  loans         Loan[]
  repayments    LoanRepayment[]

  @@unique([mandalId, userId])
  @@map("mandal_members")
}

// ==============================
// MEMBER ACCOUNTS
// ==============================

model MemberAccount {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  accountName   String    @map("account_name")
  bankName      String?   @map("bank_name")
  accountNumber String?   @map("account_number")
  ifscCode      String?   @map("ifsc_code")
  upiId         String?   @map("upi_id")
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("member_accounts")
}

// ==============================
// PAYMENT METHODS
// ==============================

model PaymentMethod {
  id                  Int                  @id @default(autoincrement())
  name                String
  type                PaymentMethodType
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  paymentTransactions PaymentTransaction[]

  @@map("payment_methods")
}

// ==============================
// SUBSCRIPTIONS
// ==============================

model Subscription {
  id                 Int                @id @default(autoincrement())
  mandalId           Int                @map("mandal_id")
  mandal             MandalMaster       @relation(fields: [mandalId], references: [id])
  packageId          Int                @map("package_id")
  package            Plan               @relation(fields: [packageId], references: [id])
  billingCycle       BillingCycle       @map("billing_cycle")
  status             SubscriptionStatus @default(TRIAL)
  startedAt          DateTime?          @map("started_at")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  @@map("subscriptions")
}

// ==============================
// CONTRIBUTIONS
// ==============================

model Contribution {
  id               Int               @id @default(autoincrement())
  mandalId         Int               @map("mandal_id")
  mandal           MandalMaster      @relation(fields: [mandalId], references: [id])
  memberId         Int               @map("member_id")
  member           MandalMember      @relation(fields: [memberId], references: [id])
  amount           Decimal           @db.Decimal(12, 2)
  type             ContributionType
  entryType        EntryType         @default(CREDIT) @map("entry_type")
  paymentMethod    PaymentMethodType @map("payment_method")
  reference        String?
  note             String?
  contributionDate DateTime          @map("contribution_date")
  createdBy        Int               @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  @@map("contributions")
}

// ==============================
// NOTIFICATIONS
// ==============================

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  mandalId    Int?             @map("mandal_id")
  mandal      MandalMaster?    @relation(fields: [mandalId], references: [id])
  title       String
  message     String
  type        NotificationType
  referenceId Int?             @map("reference_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@map("notifications")
}

// ==============================
// PAYMENT TRANSACTIONS
// ==============================

model PaymentTransaction {
  id              Int                @id @default(autoincrement())
  transactionId   String?            @unique @map("transaction_id")
  mandalId        Int?               @map("mandal_id")
  mandal          MandalMaster?      @relation(fields: [mandalId], references: [id])
  userId          Int?               @map("user_id")
  user            User?              @relation(fields: [userId], references: [id])
  paymentMethodId Int?               @map("payment_method_id")
  paymentMethod   PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  paymentType     TransactionType?   @map("payment_type")
  entryType       EntryType?         @map("entry_type")
  remarks         String?
  amount          Decimal            @db.Decimal(12, 2)
  currency        String             @default("INR")
  status          String             @default("PENDING")
  initiatedAt     DateTime?          @map("initiated_at")
  paidAt          DateTime?          @map("paid_at")
  failedAt        DateTime?          @map("failed_at")
  refundedAt      DateTime?          @map("refunded_at")
  failureCode     String?            @map("failure_code")
  failureMessage  String?            @map("failure_message")
  gatewayResponse Json?              @map("gateway_response")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  loanRepayments  LoanRepayment[]

  @@map("payment_transactions")
}

// ==============================
// DRAW WINNER
// ==============================

model DrawWinner {
  id        Int          @id @default(autoincrement())
  mandalId  Int          @map("mandal_id")
  mandal    MandalMaster @relation(fields: [mandalId], references: [id])
  memberId  Int          @map("member_id")
  member    MandalMember @relation(fields: [memberId], references: [id])
  wonAt     DateTime     @default(now()) @map("won_at")
  amount    Decimal?     @db.Decimal(12, 2)
  remarks   String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@map("draw_winners")
}

// ==============================
// LOAN
// ==============================

model Loan {
  id              BigInt     @id @default(autoincrement())
  mandalId        Int        @map("mandal_id")
  memberId        Int        @map("member_id")
  requestedAmount Decimal    @map("requested_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?   @map("approved_amount") @db.Decimal(12, 2)
  disbursedAmount Decimal?   @map("disbursed_amount") @db.Decimal(12, 2)
  loanPurpose     String?    @map("loan_purpose")
  description     String?    @db.Text
  status          LoanStatus @default(PENDING)
  rejectionReason String?    @map("rejection_reason") @db.Text

  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  disbursedAt DateTime? @map("disbursed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mandal     MandalMaster    @relation(fields: [mandalId], references: [id])
  member     MandalMember    @relation(fields: [memberId], references: [id])
  approvals  LoanApproval[]
  repayments LoanRepayment[]

  @@map("loans")
}

// ==============================
// LOAN APPROVAL
// ==============================

model LoanApproval {
  id             BigInt      @id @default(autoincrement())
  loanId         BigInt      @map("loan_id")
  action         String
  previousStatus LoanStatus? @map("previous_status")
  newStatus      LoanStatus  @map("new_status")
  approvedAmount Decimal?    @map("approved_amount") @db.Decimal(12, 2)
  reason         String?     @db.Text
  remarks        String?     @db.Text
  actionBy       Int         @map("action_by")
  actionAt       DateTime    @default(now()) @map("action_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  loan       Loan @relation(fields: [loanId], references: [id])
  actionUser User @relation(fields: [actionBy], references: [id])

  @@map("loan_approvals")
}

// ==============================
// LOAN REPAYMENT
// ==============================

model LoanRepayment {
  id                   BigInt            @id @default(autoincrement())
  loanId               BigInt            @map("loan_id")
  memberId             Int               @map("member_id")
  mandalId             Int               @map("mandal_id")
  amount               Decimal           @db.Decimal(12, 2)
  paymentMethod        PaymentMethodType @map("payment_method")
  paymentTransactionId Int?              @map("payment_transaction_id")
  paymentDate          DateTime          @map("payment_date")
  status               String            @default("COMPLETED")
  remarks              String?           @db.Text
  createdBy            Int               @map("created_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  loan          Loan                @relation(fields: [loanId], references: [id])
  member        MandalMember        @relation(fields: [memberId], references: [id])
  mandal        MandalMaster        @relation(fields: [mandalId], references: [id])
  transaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  createdByUser User                @relation(fields: [createdBy], references: [id])

  @@map("loan_repayments")
}