generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/****  Common Enums  ****/

enum Status {
  ACTIVE
  INACTIVE
}

/****  User Enums  ****/

enum UserStatus {
  ACTIVE
  INACTIVE
  PAYMENT_PENDING
  PENDING
}

enum UserType {
  MANDAL_ADMIN
  MEMBER
  SUPER_ADMIN
}


/****  Mandal Enums  ****/

enum MANDAL_STRATEGY {
  GROWING
  COLLECTIVE
}

enum MANDAL_SIZE { 
  SMALL
  MEDIUM
  LARGE
  JUMBO
}


model MandalMaster {
  id         Int      @id @default(autoincrement())
  mandalId   String   @unique @map("mandal_id")
  mandalName String   @map("mandal_name")
  mandalStrategy  MANDAL_STRATEGY @map("mandal_strategy")
  mandalSize  MANDAL_SIZE  @map("mandal_size")
  status     Status   @default(ACTIVE)
  isTrialActive Boolean @map("is_trial_active") @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  members MandalMember[]

  @@map("mandal_master")
}

model User {
  id               Int       @id @default(autoincrement())
  userType         UserType  @map("user_type")
  fullName         String    @map("full_name")
  email            String    @unique
  countryCode      String    @default("+91") @map("country_code")
  mobileNumber     String    @map("mobile_number")
  isMobileVerified Boolean   @default(false) @map("is_mobile_verified")
  birthDate        DateTime? @map("birth_date")
  status           Status    @default(ACTIVE)
  lastLoggedInAt   DateTime? @map("last_loggedin_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  memberships MandalMember[]

  @@unique([countryCode, mobileNumber])
  @@map("users")
}

model OtpMaster {
  id          Int      @id @default(autoincrement())
  countryCode String   @default("+91") @map("country_code")
  mobileNumber String  @map("mobile_number")
  otp         String
  expireAt    DateTime @map("expire_at")
  isUsed      Boolean  @default(false) @map("is_used")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([countryCode, mobileNumber, isUsed])
  @@map("otp_master")
}

model MandalMember {
  id        Int      @id @default(autoincrement())
  mandalId  Int      @map("mandal_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mandal MandalMaster @relation(fields: [mandalId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([mandalId, userId])
  @@map("mandal_members")
}
